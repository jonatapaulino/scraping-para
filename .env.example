# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=scraper
RABBITMQ_PASS=scraper
RABBITMQ_VHOST=/

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scraper
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper

# MinIO (S3)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=raw-docs
MINIO_SECURE=false

# Pasta do host (montada no worker-download) para gravar os PDFs direto; vazio = so MinIO
LOCAL_EXPORT_DIR=/downloads

# Browserless (headless Chrome) para paginas com JS pesado
BROWSERLESS_URL=http://browserless:3000
BROWSERLESS_TOKEN=scraper
RENDER_FALLBACK=true

# Pool de proxies rotativos (separados por virgula; vazio = conexao direta)
PROXY_POOL=

# Resiliencia / rate limit
MAX_RETRIES=5
RETRY_BASE_SECONDS=120
DISCOVERY_DELAY_SECONDS=2
DOWNLOAD_DELAY_SECONDS=2
DISCOVERY_MAX_DEPTH=2
HTTP_TIMEOUT_SECONDS=30

# Celery Beat: cron "min hora dia-mes mes dia-semana"
CELERY_BEAT_CRON=0 6 * * *

# Seed inicial de secretarias: SIGLA=url_base;SIGLA2=url2
SEED_SECRETARIAS=
