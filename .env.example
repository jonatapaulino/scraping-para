# Versao do sistema (imagem ghcr.io/jonatapaulino/scraping-para). Quem ajusta e o
# deploy/atualizar.sh; vazio = latest
SCRAPER_VERSAO=

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=scraper
RABBITMQ_PASS=scraper
RABBITMQ_VHOST=/

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scraper
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper

# Prefixo dos caminhos guardados no banco (historico) — nao mudar
MINIO_BUCKET=raw-docs

# Arquivos baixados: UMA copia, so nesta pasta.
# DOWNLOADS_DIR = pasta no computador/servidor (padrao ./downloads; pode ser outro disco)
# ARQUIVOS_DIR  = a mesma pasta vista de dentro dos containers (nao mudar)
DOWNLOADS_DIR=./downloads
ARQUIVOS_DIR=/downloads

# Browserless (headless Chrome) para paginas com JS pesado
BROWSERLESS_URL=http://browserless:3000
BROWSERLESS_TOKEN=scraper
RENDER_FALLBACK=true

# Painel: 127.0.0.1 = so neste computador; 0.0.0.0 = outros aparelhos da rede
# (o painel nao tem login — so abra em rede confiavel)
PAINEL_BIND=127.0.0.1

# Pool de proxies rotativos (separados por ; ou ,; vazio = conexao direta)
PROXY_POOL=

# Resiliencia / rate limit
MAX_RETRIES=5
RETRY_BASE_SECONDS=120
DISCOVERY_DELAY_SECONDS=2
DOWNLOAD_DELAY_SECONDS=2
DISCOVERY_MAX_DEPTH=2
HTTP_TIMEOUT_SECONDS=30

# Celery Beat: cron "min hora dia-mes mes dia-semana"
CELERY_BEAT_CRON=0 6 * * *

# Janela de dedup de paginas (horas): dentro dela a pagina nao e re-raspada;
# depois dela, volta a ser rastreada nas rodadas seguintes
CRAWL_DEDUP_HOURS=20

# Reconciliador: docs PENDING / jobs RUNNING mais velhos que isso viram FAILED
DOC_ORPHAN_HOURS=8
JOB_STALL_HOURS=24
RECONCILE_CRON=*/30 * * * *

# API de dados abertos da transparencia (folha de pagamento)
FOLHA_API_BASE=https://api-servidores-publicos.sistemas.pa.gov.br/dados-transparencias
FOLHA_PAGE_SIZE=1000
FOLHA_PAGE_DELAY_SECONDS=1
DESPESAS_API_BASE=https://api-despesas-publicas.sistemas.pa.gov.br/despesas
EMPENHOS_API_BASE=https://api-notas-empenho.sistemas.pa.gov.br
TRANSF_REC_API_BASE=https://api-transferencia-recursos.sistemas.pa.gov.br
RECEITAS_API_BASE=https://api-receitas-publicas.sistemas.pa.gov.br
DIARIAS_API_BASE=https://api-despesas-diarias.sistemas.pa.gov.br
SUPRIMENTO_API_BASE=https://api-suprimento-fundos.sistemas.pa.gov.br
OBRAS_API_BASE=https://api-obras-publicas.sistemas.pa.gov.br
AREAS_API_BASE=https://api-areas-tematicas.sistemas.pa.gov.br
BENS_MOVEIS_API_BASE=https://api-bens-moveis.sistemas.pa.gov.br
BENS_IMOVEIS_API_BASE=https://api-bens-imoveis.sistemas.pa.gov.br
TRANSF_VOL_API_BASE=https://api-transferencias-voluntarias.sistemas.pa.gov.br
PNCP_API_BASE=https://pncp.gov.br/api/consulta/v1
PNCP_FILES_BASE=https://pncp.gov.br/pncp-api/v1

# Espelho no Google Drive — precisa de ./secrets/gdrive.json (service account)
# e da pasta-raiz compartilhada com o email da conta de servico
GDRIVE_ENABLED=false
GDRIVE_CREDENTIALS_PATH=/secrets/gdrive.json
GDRIVE_ROOT_FOLDER_ID=

# Seed inicial de secretarias: SIGLA=url_base;SIGLA2=url2
SEED_SECRETARIAS=

# --- automacao (Beat) ---
# BEAT_CRAWL_ENABLED=true  # crawl diario das secretarias cadastradas
# AUTO_DATASETS_ENABLED=false  # coleta automatica de dados abertos + diario
# AUTO_ORGAOS=DETRAN,PRODEPA,SEDUC,SEGUP,SESPA
# AUTO_DIARIO_CRON=0 6 * * *   (UTC)
# AUTO_MENSAIS_CRON=0 9 * * 1  (UTC)
